{
  "name": "orbzox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OrbZox by ORVLI — shared foundations for a real-time 1v1 arcade sports game",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
